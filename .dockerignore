# Default deny: this is a runtime-only context, not a repository upload.
**

!Dockerfile
!pyproject.toml
!app.py

!.streamlit/
.streamlit/**
!.streamlit/config.toml

!src/
!src/**

!decision/
decision/**
!decision/decision_snapshot.json

!evidence/
evidence/**
!evidence/normalized_snapshot.json
!evidence/historical_analysis_summary.json

!memos/
memos/**
!memos/company_memos.json

!prompts/
prompts/**
!prompts/portfolio_intelligence_prompt_v1.txt

# Final denials also protect nested files inside the allowed source tree.
# Never append an exception below these rules.
**/.env
**/.env.*
**/*[Ss]ecret*
**/*[Cc]redential*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.crt
**/*.cer
**/*.xlsx
**/*.xls
**/*.xlsm
**/*.pdf
**/*.[Pp][Dd][Ff]
**/*.[Xx][Ll][Ss]
**/*.[Xx][Ll][Ss][Xx]
**/*.[Xx][Ll][Ss][Mm]
**/*[Ss][Ee][Cc][Rr][Ee][Tt]*
**/*[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]*
**/.git
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/assessment_inputs
**/data
**/local_data
**/raw
**/decrypted
